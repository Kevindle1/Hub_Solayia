# Supabase — partagé par toutes les apps (valeurs à récupérer dans le dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SSO du hub : domaine parent sur lequel scoper le cookie de session.
# En prod, ex. ".solayia.fr" pour partager la session entre les sous-domaines.
# Laisser vide en développement local.
COOKIE_DOMAIN=

# URLs des modules (utilisées par les tuiles du hub)
NEXT_PUBLIC_URL_IA_SOLAYIA=http://localhost:3001
NEXT_PUBLIC_URL_CRM=http://localhost:3002
